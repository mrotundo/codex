{
  "name": "codex-server",
  "version": "1.0.0",
  "description": "API server for Codex AI agent",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:node22": "./start-dev.sh",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/services/database.ts init",
    "db:migrate": "node migrate-db.js",
    "db:migrate:location": "node migrate-db-location.js",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"yellow,cyan\" \"npm run dev\" \"cd ../codex-ui && npm run dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
